QWidget#labelContainer {
    background-color: #f4f7fb;
    border: 1px solid #d9e2ef;
    border-radius: 12px;
    padding: 12px;
}

QWidget#deviceCard {
    background-color: #ffffff;
    border: 1px solid #d6e0ee;
    border-radius: 10px;
    padding: 10px;
}

QWidget#deviceCard:hover {
    border: 1px solid #9db8d8;
    background-color: #fbfdff;
}

QLabel#deviceId {
    color: #0b2d4d;
    font-size: 16px;
    font-weight: 500;
    padding-bottom: 4px;
}

QLabel#measuringLabel {
    color: #607086;
    font-size: 12px;
    font-weight: 500;
}

QLabel#measuringValue {
    color: #123c68;
    font-size: 16px;
    font-weight: 500;
    padding-left: 6px;
}

QPushButton {
    background-color: #123c68;
    color: #ffffff;
    border: 1px solid #0d2f52;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #1a4f82;
    border-color: #123c68;
}

QPushButton:pressed {
    background-color: #0b2d4d;
    border-color: #081f37;
}

QPushButton:checked {
    background-color: #0b2d4d;
    border-color: #081f37;
}

QPushButton:disabled {
    background-color: #e8edf4;
    color: #8d99ab;
    border-color: #d7deea;
}